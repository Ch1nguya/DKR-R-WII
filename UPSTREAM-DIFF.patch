+                if (c & CLASSIC_CTRL_BUTTON_B)      n64 |= 0x4000;
+                if (c & (CLASSIC_CTRL_BUTTON_ZL | CLASSIC_CTRL_BUTTON_ZR)) n64 |= 0x2000;
+                if (c & CLASSIC_CTRL_BUTTON_PLUS)   n64 |= 0x1000;
+                if (c & CLASSIC_CTRL_BUTTON_UP)     n64 |= 0x0800;
+                if (c & CLASSIC_CTRL_BUTTON_DOWN)   n64 |= 0x0400;
+                if (c & CLASSIC_CTRL_BUTTON_LEFT)   n64 |= 0x0200;
+                if (c & CLASSIC_CTRL_BUTTON_RIGHT)  n64 |= 0x0100;
+                if (c & CLASSIC_CTRL_BUTTON_FULL_L) n64 |= 0x0020;
+                if (c & CLASSIC_CTRL_BUTTON_FULL_R) n64 |= 0x0010;
+                if (c & CLASSIC_CTRL_BUTTON_X)      n64 |= 0x0008;
+                if (c & CLASSIC_CTRL_BUTTON_Y)      n64 |= 0x0002;
+                const float lx = WiiAxis(exp.classic.ljs, false, 0.15F);
+                const float ly = WiiAxis(exp.classic.ljs, true, 0.15F);
+                if (lx != 0.0F || ly != 0.0F) { sx = lx; sy = ly; }
+                const float rx = WiiAxis(exp.classic.rjs, false, 0.5F);
+                const float ry = WiiAxis(exp.classic.rjs, true, 0.5F);
+                if (ry > 0.0F) n64 |= 0x0008;
+                if (ry < 0.0F) n64 |= 0x0004;
+                if (rx < 0.0F) n64 |= 0x0002;
+                if (rx > 0.0F) n64 |= 0x0001;
+            } else if (exp.type == WPAD_EXP_NUNCHUK) {
+                // Wiimote (main droite) + Nunchuk (stick) : A/B comme sur N64
+                if (w & WPAD_BUTTON_A)     n64 |= 0x8000;
+                if (w & WPAD_BUTTON_B)     n64 |= 0x4000;
+                if (w & WPAD_BUTTON_PLUS)  n64 |= 0x1000;
+                if (w & WPAD_BUTTON_UP)    n64 |= 0x0800;
+                if (w & WPAD_BUTTON_DOWN)  n64 |= 0x0400;
+                if (w & WPAD_BUTTON_LEFT)  n64 |= 0x0200;
+                if (w & WPAD_BUTTON_RIGHT) n64 |= 0x0100;
+                if (w & WPAD_BUTTON_1)     n64 |= 0x0008;
+                if (w & WPAD_BUTTON_2)     n64 |= 0x0004;
+                if (w & WPAD_BUTTON_MINUS) n64 |= 0x0020;
+                if (exp.nunchuk.btns & NUNCHUK_BUTTON_Z) n64 |= 0x2000;
+                if (exp.nunchuk.btns & NUNCHUK_BUTTON_C) n64 |= 0x0010;
+                const float nx = WiiAxis(exp.nunchuk.js, false, 0.15F);
+                const float ny = WiiAxis(exp.nunchuk.js, true, 0.15F);
+                if (nx != 0.0F || ny != 0.0F) { sx = nx; sy = ny; }
+            } else {
+                // Wiimote tenue a l'horizontale (comme une manette NES / dans un support volant)
+                if (w & WPAD_BUTTON_2)     n64 |= 0x8000; // A : accelerer
+                if (w & WPAD_BUTTON_1)     n64 |= 0x4000; // B : freiner
+                if (w & WPAD_BUTTON_B)     n64 |= 0x2000; // Z (gachette) : arme
+                if (w & WPAD_BUTTON_A)     n64 |= 0x0010; // R : derapage/saut
+                if (w & WPAD_BUTTON_PLUS)  n64 |= 0x1000; // Start
+                if (w & WPAD_BUTTON_MINUS) n64 |= 0x0020; // L
+                // + et - ensemble : active/desactive la direction par inclinaison (le Start/L ci-dessus sont alors aussi emis une frame)
+                const bool combo = (w & WPAD_BUTTON_PLUS) && (w & WPAD_BUTTON_MINUS);
+                if (combo && !g_wii_combo_prev[player]) {
+                    g_wii_tilt.enabled = !g_wii_tilt.enabled;
+                    g_wii_pulse[player] = g_wii_tilt.enabled ? 14 : 4;
+                }
+                g_wii_combo_prev[player] = combo;
+                if (combo) n64 &= static_cast<std::uint16_t>(~0x1020U);
+                if (g_wii_tilt.enabled) {
+                    // Pave directionnel (tourne de 90 degres) = croix N64 pour les menus ; le volant = stick
+                    if (w & WPAD_BUTTON_UP)    n64 |= 0x0200;
+                    if (w & WPAD_BUTTON_DOWN)  n64 |= 0x0100;
+                    if (w & WPAD_BUTTON_LEFT)  n64 |= 0x0400;
+                    if (w & WPAD_BUTTON_RIGHT) n64 |= 0x0800;
+                    bool ok = false;
+                    const float ang = WiiWheelAngle(static_cast<int>(player), &ok);
+                    if (ok) {
+                        float v = 0.0F;
+                        if (std::fabs(ang) > g_wii_tilt.dead_deg) {
+                            v = (std::fabs(ang) - g_wii_tilt.dead_deg) / (g_wii_tilt.range_deg - g_wii_tilt.dead_deg);
+                            v = std::copysign(std::min(v, 1.0F), ang);
+                        }
+                        sx = g_wii_tilt.invert ? -v : v;
+                    }
+                } else {
+                    if (w & WPAD_BUTTON_UP)    sx = -1.0F;    // tournee de 90 degres : haut = gauche
+                    if (w & WPAD_BUTTON_DOWN)  sx = 1.0F;
+                    if (w & WPAD_BUTTON_LEFT)  sy = -1.0F;
+                    if (w & WPAD_BUTTON_RIGHT) sy = 1.0F;
+                }
+            }
+        }
+
+        if (g_wii_pulse[player] > 0) {
+            --g_wii_pulse[player];
+            WPAD_Rumble(static_cast<int>(player), g_wii_pulse[player] > 0 ? 1 : 0);
+        }
+        if (player == 0) ApplyAutoInput(&n64, &sx, &sy);
+        g_wii_connected[player].store(connected, std::memory_order_release);
+        g_buttons[player].store(n64, std::memory_order_release);
+        g_stick_x[player].store(sx, std::memory_order_release);
+        g_stick_y[player].store(sy, std::memory_order_release);
+        g_physical_buttons[player].store(n64, std::memory_order_release);
+        g_physical_stick_x[player].store(sx, std::memory_order_release);
+        g_physical_stick_y[player].store(sy, std::memory_order_release);
+    }
+}
