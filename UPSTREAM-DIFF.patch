+// File d'attente audio : le jeu produit des blocs stéréo 16 bits (big-endian, comme ASND) ; la voix ASND les consomme par
+// morceaux de kWiiChunkFrames via son callback (appelé dans le thread ASND). Indices monotones en trames stéréo.
+constexpr u32 kWiiRingFrames = 16384; // puissance de 2
+constexpr u32 kWiiChunkFrames = 512;
+alignas(32) s16 g_wii_ring[kWiiRingFrames * 2];
+alignas(32) u8 g_wii_chunk[2][kWiiChunkFrames * 4];
+std::atomic<u32> g_wii_ring_r{0};
+std::atomic<u32> g_wii_ring_w{0};
+std::atomic<u32> g_wii_underruns{0};
