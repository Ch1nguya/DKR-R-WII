+void WiiFillChunk(u8* dst) {
+    const u32 r = g_wii_ring_r.load(std::memory_order_acquire);
+    const u32 w = g_wii_ring_w.load(std::memory_order_acquire);
+    const u32 avail = w - r;
+    const u32 n = avail < kWiiChunkFrames ? avail : kWiiChunkFrames;
+    s16* out = reinterpret_cast<s16*>(dst);
+    for (u32 i = 0; i < n; ++i) {
+        const u32 src = ((r + i) & (kWiiRingFrames - 1)) * 2;
+        out[i * 2] = g_wii_ring[src];
+        out[i * 2 + 1] = g_wii_ring[src + 1];
+    }
+    for (u32 i = n * 2; i < kWiiChunkFrames * 2; ++i) out[i] = 0;
+    if (n < kWiiChunkFrames) g_wii_underruns.fetch_add(1, std::memory_order_relaxed);
+    g_wii_ring_r.store(r + n, std::memory_order_release);
+    DCFlushRange(dst, kWiiChunkFrames * 4);
+}
+
+void WiiVoiceCallback(s32 voice) {
+    u8* buf = g_wii_chunk[g_wii_chunk_idx ^= 1];
+    WiiFillChunk(buf);
+    ASND_AddVoice(voice, buf, kWiiChunkFrames * 4);
+}
