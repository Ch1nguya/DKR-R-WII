+    g_wii_voice_started = true;
+    u8* buf = g_wii_chunk[0];
+    g_wii_chunk_idx = 0;
+    WiiFillChunk(buf);
+    ASND_SetVoice(0, VOICE_STEREO_16BIT, static_cast<s32>(frequency), 0, buf, kWiiChunkFrames * 4, 255, 255, WiiVoiceCallback);
+}
