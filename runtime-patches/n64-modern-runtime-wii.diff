+		u32 val = 0;
+		if (LWP_SemGetValue(m_sema, &val) == 0 && val > 0) {
+			return LWP_SemWait(m_sema) == 0;
+		}
+		return false;
+	}
+
+	bool timed_wait(std::uint64_t usecs)
+	{
+		if (try_wait()) return true;
+		if (usecs == 0) return false;
+
+		std::uint64_t remaining = usecs;
+		while (remaining > 0) {
+			std::uint64_t step = (remaining > 100) ? 100 : remaining;
+			usleep(step);
+			if (try_wait()) return true;
+			if (remaining <= step) break;
+			remaining -= step;
+		}
+		return false;
+	}
+
+	void signal()
+	{
+		LWP_SemPost(m_sema);
+	}
+
+	void signal(int count)
+	{
+		while (count-- > 0)
+		{
+			LWP_SemPost(m_sema);
+		}
+	}
